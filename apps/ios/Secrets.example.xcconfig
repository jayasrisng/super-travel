// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is git-ignored.
GEMINI_API_KEY =
// Optional: number pre-filled in Settings > Nearby alerts (digits only).
DEFAULT_ALERT_PHONE =
// Optional: HTTPS endpoint that accepts {"to","body"} and sends the SMS.
// In xcconfig write the slashes as https:/$()/example.com/send
SMS_RELAY_URL =
