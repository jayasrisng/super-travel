{
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "name": "wonder-consumer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "contracts": "openapi-typescript ../../packages/contracts/openapi.json -o src/api.generated.ts",
    "format": "prettier --write src tests playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src tests playwright.config.ts vite.config.ts"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.13"
  }
}
