# Wonder configuration inventory — no app consumes this root file yet.
# Copy names to owned runtime config during Phase 0; never commit real values.
# Public browser values: API URL, Supabase URL and publishable auth key only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server configuration: do not copy to NEXT_PUBLIC_* or Swift xcconfig.
APP_ENV=local
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# DATABASE_URL runtime role must be non-admin, non-BYPASSRLS.
# Migration/CI credentials configured separately, never in a client.
PROVIDER_MODE=fixture
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
MAPS_SERVER_API_KEY=
WEATHER_API_KEY=
MAGIC_AREA=barcelona
MAGIC_TIMEZONE=Europe/Madrid
MAGIC_CURRENCY=EUR
MAGIC_COVERAGE_CONFIG=
AGENT_RUN_DEADLINE_SECONDS=120
AGENT_RUN_MAX_ATTEMPTS=3
# Set tested per-user/global quotas and explicit budget before live enablement.
AI_DAILY_USER_LIMIT=
PROVIDER_MONTHLY_BUDGET_MINOR=
BUDGET_CURRENCY=
# Optional sponsor adapters, individually enabled after access/consent review.
DARWIN_ENABLED=false
DARWIN_API_KEY=
DARWIN_ACT_ENABLED=false
KEEWANO_ENABLED=false
KEEWANO_INGRESS_KEY=
KEEWANO_QUERY_TOKEN=
DIAL_ENABLED=false
DIAL_API_KEY=
DIAL_SENDER_NUMBER=
DIAL_WEBHOOK_SECRET=
# Sparta/Alike are optional developer tooling; validate official setup separately.
# Never commit MCP tokens or capture transcripts with secrets.
SENTRY_DSN=
POSTHOG_KEY=
ANALYTICS_ENABLED=false
